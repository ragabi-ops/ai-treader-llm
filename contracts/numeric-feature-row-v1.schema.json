{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "numeric-feature-row-v1"
    },
    "row_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "numeric-common-v1.schema.json#/$defs/source"
      },
      "minItems": 0
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "feature_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "value": {
            "$ref": "numeric-common-v1.schema.json#/$defs/feature_value"
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "minItems": 0,
            "uniqueItems": true
          }
        },
        "required": [
          "feature_id",
          "value",
          "source_ids"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "row_id",
    "sources",
    "features"
  ]
}
