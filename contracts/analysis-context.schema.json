{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TrustedAnalysisContextV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "as_of_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "metric_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "required": [
    "symbol",
    "as_of_timestamp",
    "evidence_ids",
    "metric_ids"
  ]
}
