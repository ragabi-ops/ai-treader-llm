{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolCallFixtureV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "role": {
            "enum": [
              "system",
              "user"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "role",
          "content"
        ]
      }
    },
    "trusted_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1
        },
        "as_of_timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "symbol",
        "as_of_timestamp"
      ]
    },
    "allowed_tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "expected_tool_names": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "description",
    "messages",
    "trusted_scope",
    "allowed_tools",
    "expected_tool_names"
  ]
}
