{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NumericV1Definitions",
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,6})?Z$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "listing_id": {
      "type": "string",
      "pattern": "^[1-9][0-9]{0,18}$",
      "description": "Canonical positive signed int64 encoded as a string; semantic validation enforces the upper bound."
    },
    "decimal": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]{0,19})(\\.[0-9]{0,17}[1-9])?$",
      "not": {
        "const": "-0"
      },
      "description": "Exact fixed-point decimal: up to 20 integer and 18 fractional digits, no exponent, plus, leading/trailing zeroes or negative zero."
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        }
      },
      "required": [
        "path",
        "sha256",
        "count"
      ]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "permitted",
            "unknown",
            "restricted",
            "synthetic_only"
          ]
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "status",
        "reference"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "content_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "available_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,6})?Z$"
        },
        "ingested_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,6})?Z$"
        },
        "license": {
          "$ref": "numeric-common-v1.schema.json#/$defs/license"
        }
      },
      "required": [
        "source_id",
        "revision",
        "content_sha256",
        "available_at",
        "ingested_at",
        "license"
      ]
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "label": {
          "enum": [
            "1m",
            "3m"
          ]
        },
        "policy": {
          "const": "xnys-calendar-months-next-open-v1"
        },
        "calendar_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "decision_session": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "entry_session": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "entry_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,6})?Z$"
        },
        "end_session": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "end_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,6})?Z$"
        }
      },
      "required": [
        "label",
        "policy",
        "calendar_sha256",
        "decision_session",
        "entry_session",
        "entry_at",
        "end_session",
        "end_at"
      ]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "row_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "listing_id": {
          "$ref": "numeric-common-v1.schema.json#/$defs/listing_id"
        },
        "as_of_timestamp": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}([.][0-9]{1,6})?Z$"
        },
        "horizon": {
          "$ref": "numeric-common-v1.schema.json#/$defs/horizon"
        }
      },
      "required": [
        "row_id",
        "listing_id",
        "as_of_timestamp",
        "horizon"
      ]
    },
    "feature_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
        },
        "feature_schema_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "feature_id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "unit": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
              },
              "definition_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "feature_id",
              "unit",
              "definition_sha256"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "version",
        "feature_schema_sha256",
        "features"
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "training_manifest_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "config_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "runtime_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      },
      "required": [
        "artifact_sha256",
        "training_manifest_sha256",
        "config_sha256",
        "code_sha256",
        "runtime_sha256",
        "seed"
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "benchmark_excess_return"
        },
        "unit": {
          "const": "decimal_return"
        },
        "benchmark_listing_id": {
          "$ref": "numeric-common-v1.schema.json#/$defs/listing_id"
        },
        "entry_policy": {
          "const": "next_session_open"
        },
        "exit_policy": {
          "const": "horizon_close"
        },
        "price_basis": {
          "enum": [
            "split_adjusted",
            "total_return_adjusted"
          ]
        },
        "definition_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": [
        "kind",
        "unit",
        "benchmark_listing_id",
        "entry_policy",
        "exit_policy",
        "price_basis",
        "definition_sha256"
      ]
    },
    "semantics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "expected_excess_return",
            "ranking_score"
          ]
        },
        "unit": {
          "enum": [
            "decimal_return",
            "unitless"
          ]
        },
        "direction": {
          "const": "higher_is_better"
        },
        "target": {
          "$ref": "numeric-common-v1.schema.json#/$defs/target"
        }
      },
      "required": [
        "kind",
        "unit",
        "direction",
        "target"
      ]
    },
    "feature_value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "$ref": "numeric-common-v1.schema.json#/$defs/decimal"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "not_collected",
                "not_available_at_cutoff",
                "not_ingested_at_cutoff",
                "provider_error",
                "license_restricted",
                "stale",
                "not_applicable"
              ]
            }
          },
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    },
    "score": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "$ref": "numeric-common-v1.schema.json#/$defs/decimal"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "missing_features",
                "out_of_domain",
                "model_error",
                "timeout",
                "cancelled",
                "non_finite_output"
              ]
            }
          },
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    },
    "label_value": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "available"
            },
            "value": {
              "$ref": "numeric-common-v1.schema.json#/$defs/decimal"
            }
          },
          "required": [
            "status",
            "value"
          ]
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "status": {
              "const": "unavailable"
            },
            "reason": {
              "enum": [
                "not_matured",
                "missing_entry",
                "missing_exit",
                "missing_benchmark",
                "delisted_no_price",
                "provider_error"
              ]
            }
          },
          "required": [
            "status",
            "reason"
          ]
        }
      ]
    }
  }
}
