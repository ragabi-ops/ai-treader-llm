{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DatasetManifestV1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "count": {"type": "integer", "minimum": 1}
      },
      "required": ["path", "sha256", "count"]
    },
    "nullable_timestamp": {
      "oneOf": [
        {"type": "string", "format": "date-time", "pattern": "Z$"},
        {"type": "null"}
      ]
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sample_count": {"type": "integer", "minimum": 0},
        "as_of_start": {"$ref": "#/$defs/nullable_timestamp"},
        "as_of_end": {"$ref": "#/$defs/nullable_timestamp"}
      },
      "required": ["sample_count", "as_of_start", "as_of_end"]
    }
  },
  "properties": {
    "schema_version": {"const": "1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "samples": {"$ref": "#/$defs/artifact"},
    "outcomes": {
      "oneOf": [
        {"$ref": "#/$defs/artifact"},
        {"type": "null"}
      ]
    },
    "splits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "train": {"$ref": "#/$defs/split"},
        "validation": {"$ref": "#/$defs/split"},
        "test": {"$ref": "#/$defs/split"}
      },
      "required": ["train", "validation", "test"]
    },
    "analysis_horizons": {
      "type": "array",
      "items": {"enum": ["1d", "5d", "30d", "90d"]},
      "minItems": 1,
      "uniqueItems": true
    },
    "split_policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "chronological": {"const": true},
        "outcome_window_purged": {"type": "boolean"},
        "embargo_days": {"type": "integer", "minimum": 0}
      },
      "required": ["chronological", "outcome_window_purged", "embargo_days"]
    },
    "licensing": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["pending", "reviewed", "synthetic_only"]},
        "notes": {"type": "string", "minLength": 1}
      },
      "required": ["status", "notes"]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["pending", "reviewed", "synthetic_only"]},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"$ref": "#/$defs/nullable_timestamp"}
      },
      "required": ["status", "reviewer", "reviewed_at"]
    }
  },
  "required": [
    "schema_version",
    "dataset_id",
    "created_at",
    "samples",
    "outcomes",
    "splits",
    "analysis_horizons",
    "split_policy",
    "licensing",
    "review"
  ]
}
