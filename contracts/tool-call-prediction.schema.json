{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ToolCallPredictionV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1"
    },
    "case_id": {
      "type": "string",
      "minLength": 1
    },
    "tool_calls": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "call_id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "arguments": {}
        },
        "required": [
          "call_id",
          "name",
          "arguments"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "tool_calls"
  ]
}
