{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DataSourceReviewV1",
  "description": "A review receipt for a real source bundle. It records source provenance, usage terms and universe limitations without embedding the source data.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "data-source-review-v1"},
    "review_id": {"$ref": "numeric-common-v1.schema.json#/$defs/identifier"},
    "created_at": {"$ref": "numeric-common-v1.schema.json#/$defs/timestamp"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "dataset": {"type": "string", "minLength": 1},
        "capture_repository": {"type": "string", "minLength": 1},
        "capture_revision": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "capture_manifest_path": {"type": "string", "minLength": 1},
        "capture_manifest_sha256": {"$ref": "numeric-common-v1.schema.json#/$defs/sha256"},
        "availability_basis": {"type": "string", "minLength": 1}
      },
      "required": [
        "provider", "dataset", "capture_repository", "capture_revision",
        "capture_manifest_path", "capture_manifest_sha256", "availability_basis"
      ]
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["permitted", "unknown", "restricted"]},
        "use_scope": {"enum": ["local_personal_research", "internal_research", "redistributable"]},
        "redistribution": {"enum": ["permitted", "permitted_with_attribution", "prohibited", "unknown"]},
        "policy_urls": {
          "type": "array",
          "items": {"type": "string", "format": "uri", "pattern": "^https://"},
          "minItems": 1,
          "uniqueItems": true
        },
        "reviewed_at": {"$ref": "numeric-common-v1.schema.json#/$defs/timestamp"},
        "reviewer": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      },
      "required": [
        "status", "use_scope", "redistribution", "policy_urls",
        "reviewed_at", "reviewer", "notes"
      ]
    },
    "universe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "selection_policy": {"type": "string", "minLength": 1},
        "selected_on": {"$ref": "numeric-common-v1.schema.json#/$defs/date"},
        "identifiers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "survivorship_status": {"enum": ["point_in_time_controlled", "survivorship_biased", "unknown"]},
        "delisted_entities_included": {"type": "boolean"},
        "eligible_for_performance_claims": {"const": false},
        "notes": {"type": "string", "minLength": 1}
      },
      "required": [
        "selection_policy", "selected_on", "identifiers", "survivorship_status",
        "delisted_entities_included", "eligible_for_performance_claims", "notes"
      ]
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "request": {"type": "string", "minLength": 1},
          "retrieved_at": {"$ref": "numeric-common-v1.schema.json#/$defs/timestamp"},
          "compression": {"const": "gzip"},
          "compressed_sha256": {"$ref": "numeric-common-v1.schema.json#/$defs/sha256"},
          "compressed_bytes": {"type": "integer", "minimum": 1},
          "content_sha256": {"$ref": "numeric-common-v1.schema.json#/$defs/sha256"},
          "content_bytes": {"type": "integer", "minimum": 1}
        },
        "required": [
          "path", "request", "retrieved_at", "compression",
          "compressed_sha256", "compressed_bytes", "content_sha256", "content_bytes"
        ]
      },
      "minItems": 1
    },
    "target_readiness": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["pending", "ready"]},
        "platform_listing_ids_pinned": {"type": "boolean"},
        "trading_calendar_pinned": {"type": "boolean"},
        "chronological_splits_pinned": {"type": "boolean"},
        "purge_embargo_pinned": {"type": "boolean"},
        "held_out_boundary_pinned": {"type": "boolean"},
        "labels_separate": {"const": true},
        "target_manifest": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "path": {"type": "string", "minLength": 1},
                "sha256": {"$ref": "numeric-common-v1.schema.json#/$defs/sha256"}
              },
              "required": ["path", "sha256"]
            },
            {"type": "null"}
          ]
        },
        "notes": {"type": "string", "minLength": 1}
      },
      "required": [
        "status", "platform_listing_ids_pinned", "trading_calendar_pinned",
        "chronological_splits_pinned", "purge_embargo_pinned",
        "held_out_boundary_pinned", "labels_separate", "target_manifest", "notes"
      ]
    }
  },
  "required": [
    "schema_version", "review_id", "created_at", "source", "access",
    "universe", "artifacts", "target_readiness"
  ]
}
