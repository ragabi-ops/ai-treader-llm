{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetPriceHistoryArgumentsV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "start_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "end_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "interval": {
      "enum": [
        "1d",
        "1h"
      ]
    }
  },
  "required": [
    "symbol",
    "start_timestamp",
    "end_timestamp",
    "interval"
  ]
}
