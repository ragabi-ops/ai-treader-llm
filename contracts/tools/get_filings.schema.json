{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GetFilingsArgumentsV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "symbol": {
      "type": "string",
      "minLength": 1
    },
    "forms": {
      "type": "array",
      "items": {
        "enum": [
          "10-K",
          "10-Q",
          "8-K"
        ]
      },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    }
  },
  "required": [
    "symbol",
    "forms",
    "limit"
  ]
}
